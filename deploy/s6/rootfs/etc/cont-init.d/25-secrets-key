#!/command/with-contenv bash

set -euo pipefail
umask 077

source_file="${SECRETS_KEY_SOURCE:-/run/secrets/dashboard-secrets-key}"
key_directory="${SECRETS_KEY_DIR:-/run/dashboard-secrets}"
retired_key_files="${SECRETS_RETIRED_KEY_FILES:-}"

fail() {
    echo "[secrets-key] $1" >&2
    exit 1
}

copy_key() {
    local source_path="$1"
    local target_path="$2"
    [[ -f "${source_path}" ]] || fail "key source not found: ${source_path}"
    [[ -r "${source_path}" ]] || fail "key source not readable: ${source_path}"
    [[ -s "${source_path}" ]] || fail "key source is empty: ${source_path}"
    cat "${source_path}" > "${target_path}" || fail "cannot copy key source: ${source_path}"
    chmod 0400 "${target_path}"
}

mkdir -p "${key_directory}"
chmod 0700 "${key_directory}"
rm -f "${key_directory}/key" "${key_directory}"/retired-*

copy_key "${source_file}" "${key_directory}/key"

retired_index=0
if [[ -n "${retired_key_files}" ]]; then
    IFS=',' read -r -a retired_paths <<< "${retired_key_files}"
    for retired_path in "${retired_paths[@]}"; do
        retired_index=$((retired_index + 1))
        copy_key "${retired_path}" "${key_directory}/retired-${retired_index}"
    done
fi

if [[ "$(id -u)" == 0 ]]; then
    chown docker-user:docker-user "${key_directory}" "${key_directory}"/*
fi
