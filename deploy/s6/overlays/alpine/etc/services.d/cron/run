#!/command/with-contenv bash
set -eu

exec 2>&1

case "${ENABLE_CRON:-true}" in
    1|true|TRUE|yes|YES|on|ON)
        ;;
    *)
        s6-svc -d /run/service/cron || true
        exit 0
        ;;
esac

supercronic_binary="${SUPERCRONIC_BIN:-/usr/bin/supercronic}"
work_dir="${CRON_WORK_DIR:-/run/supercronic}"
cron_directory="${CRON_DIR:-/etc/cron.d}"
geoip_directory="${GEOIP_DIR:-/var/lib/geoip}"
cron_file="${work_dir}/crontab"
mkdir -p "${work_dir}"

{
    echo "SHELL=/bin/bash"
    echo "PATH=/command:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    for file in "${cron_directory}"/*; do
        [ -f "${file}" ] || continue
        set -f
        # shellcheck disable=SC2086
        while IFS= read -r line || [ -n "${line}" ]; do
            case "${line}" in
                ""|\#*) echo "${line}" ;;
                @*)
                    set -- ${line}
                    if [ "${2:-}" = "root" ]; then
                        echo "${1} ${*:3}"
                    else
                        echo "${line}"
                    fi
                    ;;
                *)
                    set -- ${line}
                    if [ "${6:-}" = "root" ]; then
                        echo "${1} ${2} ${3} ${4} ${5} ${*:7}"
                    else
                        echo "${line}"
                    fi
                    ;;
            esac
        done < "${file}"
        set +f
    done
} > "${cron_file}"

if [ -f "${cron_directory}/geoipupdate" ] && [ ! -s "${geoip_directory}/GeoLite2-Country.mmdb" ]; then
    (run_as_docker_user /usr/local/bin/geoipupdate-once &)
fi

exec "${supercronic_binary}" "${cron_file}"
