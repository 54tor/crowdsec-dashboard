# Copy to dashboard.env (chmod 600), never commit the copy.
#
# PostgreSQL connection, same user, password and database as in postgres.env. The host is the
# postgres service of compose.example.yaml. Percent-encode special characters of the password.
# The dashboard refuses to start when the database is unreachable or a migration fails.
DATABASE_URL='postgres://dashboard:replace-me@postgres:5432/dashboard?sslmode=disable'

# Password of the LAPI machine account used by the dashboard, created with:
#   docker exec crowdsec cscli machines add dashboard --password '<password>' -f /dev/null
LAPI_MACHINE_PASSWORD='replace-me'

# GeoLite2 credentials are compose secret files (maxmind-account-id, maxmind-license-key), never variables here.
# Without them no update is scheduled and country rules are refused.

# The secrets key itself is a compose secret file (dashboard-secrets-key), never a variable here.
# Key rotation sets SECRETS_RETIRED_KEY_SOURCES and SECRETS_RETIRED_KEY_FILES in compose.example.yaml.

# Engine synchronisation (docs/sync.md). Peers are the engines of the Engines page marked as sync
# peers; a peers file (SYNC_PEERS_FILE) is refused at start. Start with the dry run, read the plan on
# the Sync page, then set SYNC_DRY_RUN=false.
SYNC_ENABLED=false
SYNC_DRY_RUN=true
SYNC_INTERVAL=5m
SYNC_MAX_CHANGES=500
SYNC_READ_LIMIT=5000
# Comma-separated CIDRs never shared by the sync nor imported, for example your own networks.
SHARE_EXCLUDE_CIDRS=

# Import of acquis.d files from a bundle (docs/bundles.md): off by default. Enabling it needs the
# dedicated writable mount shown in compose.example.yaml.
CONFIG_IMPORT_ENABLED=false
# CONFIG_IMPORT_DIR=/var/lib/dashboard-acquis.d
