# Copy to dashboard.env (chmod 600), never commit the copy.
#
# argon2id hash of the admin password. Read it silently so that it stays out of the shell
# history and out of process lists (here-string, not an argument):
#   read -rs -p 'Admin password: ' admin_password; echo
#   (cd backend && go run ./cmd/hashpassword) <<< "$admin_password"
# or, with the built image (no Go toolchain needed):
#   docker run --rm -i --entrypoint /hashpassword crowdsec-dashboard:latest <<< "$admin_password"
#   unset admin_password
# Keep the single quotes around the hash: it contains "$". The dashboard refuses to start
# when this value is not a valid argon2id hash.
ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=1,p=32$replace-me$replace-me'

# Password of the LAPI machine account used by the dashboard, created with:
#   docker exec crowdsec cscli machines add dashboard --password '<password>' -f /dev/null
LAPI_MACHINE_PASSWORD='replace-me'
