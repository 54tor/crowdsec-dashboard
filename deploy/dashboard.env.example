# Copy to dashboard.env (chmod 600), never commit the copy.
#
# argon2id hash of the admin password:
#   printf '%s' 'your-password' | (cd backend && go run ./cmd/hashpassword)
# Keep the single quotes: the hash contains "$".
ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=1,p=32$replace-me$replace-me'

# Password of the LAPI machine account used by the dashboard, created with:
#   docker exec crowdsec cscli machines add dashboard --password '<password>' -f /dev/null
LAPI_MACHINE_PASSWORD='replace-me'
